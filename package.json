{
  "name": "agentic-playwright-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright and TypeScript end to end and visual regression suite, authored and healed through Claude Code agents over Playwright MCP",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.5.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:api": "playwright test --project=api",
    "test:e2e:report": "playwright show-report",
    "test:vr": "playwright test --project=visual",
    "test:vr:update": "playwright test --project=visual --update-snapshots",
    "docker:build": "docker compose build runner",
    "docker:vr": "docker compose run --rm runner yarn test:vr",
    "docker:vr:update": "docker compose run --rm runner yarn test:vr:update",
    "docker:e2e": "docker compose run --rm runner yarn test:e2e",
    "metrics": "node utils/scripts/suite-health.mjs",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "yarn typecheck && yarn lint && yarn format:check",
    "playwright:install": "playwright install --with-deps chromium webkit",
    "playwright:install:chromium": "playwright install --with-deps chromium",
    "feed": "node utils/scripts/build-feed.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "allure-playwright": "^3.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-playwright": "^2.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  }
}
